{
  "name": "motion-mate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"tests/**/*.js\" \"*.{js,json,html}\" \"public/manifest.webmanifest\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"tests/**/*.js\" \"*.{js,json,html}\" \"public/manifest.webmanifest\""
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@vitejs/plugin-react": "^6.2.1",
    "daisyui": "^5.7.50",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.6"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "minimatch": "^11.0.4"
  }
}
